+++ b/src/local-drag-speed.h
@@ -0,0 +1,39 @@
+/* Local extension: read the drag-only multiplier once at gesture start. */
+#ifndef LOCAL_DRAG_SPEED_H
+#define LOCAL_DRAG_SPEED_H
+#include <math.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+static inline double
+local_drag_speed_read(void)
+{
+    const char *path = getenv("THREE_FINGER_DRAG_SPEED_FILE");
+    if (!path || !*path)
+        return 1.0;
+    FILE *file = fopen(path, "re");
+    if (!file)
+        return 1.0;
+    double speed = 1.0;
+    char extra;
+    int fields = fscanf(file, "%lf %c", &speed, &extra);
+    fclose(file);
+    if (fields != 1 || !isfinite(speed) || speed < 0.1 || speed > 1.0)
+        return 1.0;
+    return speed;
+}
+
+static inline void
+local_drag_speed_scale(bool dragging, double speed,
+                      double *dx, double *dy,
+                      double *raw_dx, double *raw_dy)
+{
+    if (!dragging)
+        return;
+    *dx *= speed;
+    *dy *= speed;
+    *raw_dx *= speed;
+    *raw_dy *= speed;
+}
+#endif
